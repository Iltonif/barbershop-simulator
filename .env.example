# Copia este archivo a ".env" (en la raíz del repo) y pon tus valores reales
# ahí -- ".env" está en .gitignore, así que nunca se sube a git. start-dev.sh
# lo carga solo si existe; si no existe, usa BARBER_PIN=1234 como valor de
# conveniencia para desarrollo local.

# PIN para entrar en la parte del peluquero (sala de espera, fichas,
# simulación). Obligatorio en Railway; en local, sin .env, se usa 1234.
BARBER_PIN=1234

# Claves de los proveedores externos (opcionales en local -- las funciones
# que las usan simplemente avisan si faltan, ver CLAUDE.md):
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# FAL_KEY=
# TRIPO_API_KEY=
